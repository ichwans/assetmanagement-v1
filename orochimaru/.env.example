# Frontend dev server proxy target for backend API
VITE_PROXY_TARGET=http://localhost:8080

# Optional: direct API base. Leave empty to use relative /api (proxy)
VITE_API_BASE=

# IPFS gateway for document preview
VITE_IPFS_GATEWAY=http://localhost:8080/ipfs

# Optional external explorer base URL
VITE_EXPLORER_URL=
